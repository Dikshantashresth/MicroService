{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/api/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE" ]
    },
    {
      "DownstreamPathTemplate": "/api/tasks",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5003
        }
      ],
      "UpstreamPathTemplate": "/api/tasks",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE", "PUT" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "ClaimsToHeaders": {
        "X-User-Id": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
        "X-Username": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name",
        "X-User-Email": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"
      }
    },
    {
      "DownstreamPathTemplate": "/api/tasks/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5003
        }
      ],
      "UpstreamPathTemplate": "/api/tasks/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "DELETE", "PUT" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "Bearer",
        "AllowedScopes": []
      },
      "ClaimsToHeaders": {
        "X-User-Id": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier",
        "X-Username": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name",
        "X-User-Email": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress"
      }

    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}